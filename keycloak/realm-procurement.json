{
  "realm": "procurement",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "admin",      "description": "Полный доступ, включая администрирование каталога (seed/reset/reindex)" },
      { "name": "manager",    "description": "РП: ведение каталога, спецификаций, генерация КП, скидки (UC-01..05)" },
      { "name": "viewer",     "description": "Только чтение (каталог, поиск, КП)" },
      { "name": "commercial", "description": "Коммерческий блок: согласование КП, расчёт маржинальности (UC-06)" },
      { "name": "accounting", "description": "Бухгалтерия: фиксация оплаты счёта NOC (UC-08)" },
      { "name": "warehouse",  "description": "Склад: приёмка товара, отражение в 1С (UC-09)" }
    ]
  },
  "clients": [
    {
      "clientId": "procurement-api",
      "name": "Procurement API / SPA",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@procurement.local",
      "firstName": "Администратор",
      "lastName": "Системы",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "email": "manager@procurement.local",
      "firstName": "Закупщик",
      "lastName": "Отдела",
      "requiredActions": [],
